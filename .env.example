# ============================================
# .env.example — Template variabili d'ambiente
# Copiare in .env e compilare con i valori reali
# QUESTO FILE VA IN GIT — nessun valore sensibile
# ============================================

# Applicazione
APP_NAME=Gestionale Calabria Verde
APP_VERSION=1.0.0
DEBUG=False
SECRET_KEY=

# Database backend FastAPI
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gestionale_cv
DB_USER=gestionale_cv_user
DB_PASSWORD=

# Database produzione legacy/import, se necessario
PROD_DB_HOST=
PROD_DB_PORT=3306
PROD_DB_NAME=
PROD_DB_USER=
PROD_DB_PASSWORD=

# JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS: formato JSON richiesto da pydantic-settings
CORS_ORIGINS=["https://smart-cv.it","https://gestionale.calabriaverde.eu","http://localhost:3000"]

# SMTP Aruba
SMTP_HOST=smtps.aruba.it
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# VPS SSH
VPS_HOST=
VPS_USER=root
VPS_SSH_KEY_PATH=storage/vps_keys/id_rsa_vps

# Bootstrap admin locale/produzione provvisoria
CV_ADMIN_PASSWORD=

# Integrazioni esterne
PC2_API_URL=
PC2_API_KEY=
WAY_SRL_API_URL=
WAY_SRL_API_KEY=
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1
NASA_FIRMS_MAP_KEY=

# Frontend static export
NEXT_PUBLIC_API_URL=https://smart-cv.it/api
NEXT_PUBLIC_BASE_PATH=/test
NEXT_PUBLIC_APP_NAME=Gestionale Calabria Verde
NEXT_PUBLIC_APP_VERSION=1.0.0
