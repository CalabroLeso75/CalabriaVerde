# .gitattributes — Gestionale Calabria Verde
# Normalizza line endings per compatibilità cross-platform

* text=auto eol=lf

# File binari — non toccare
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.sqlite binary
*.db binary

# Windows
*.ps1 text eol=crlf

# Script Unix
*.sh text eol=lf
*.py text eol=lf

# Web
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
